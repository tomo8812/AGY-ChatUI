[Unit]
Description=Antigravity Chat UI Server (Official ACP Client)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=antigravity
Group=antigravity
WorkingDirectory=/opt/antigravity-chat
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=TRUST_PROXY=true
Environment=DATA_ROOT=/var/lib/antigravity-chat
Environment=AGY_BIN=agy
# Recommended on VM.Standard.A1.Flex (2 OCPU / 12GB RAM): MAX_CONCURRENT_ACP=2 (or 3 if I/O-only), MAX_ACP_PER_USER=2, IDLE_WORKER_MS=600000
# Recommended on VM.Standard.E2.1.Micro (1/8 OCPU / 1GB RAM): MAX_CONCURRENT_ACP=1, MAX_ACP_PER_USER=1, IDLE_WORKER_MS=180000
Environment=MAX_CONCURRENT_ACP=2
Environment=MAX_ACP_PER_USER=2
Environment=IDLE_WORKER_MS=600000
ExecStart=/usr/bin/node /opt/antigravity-chat/server/dist/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/antigravity-chat

[Install]
WantedBy=multi-user.target
